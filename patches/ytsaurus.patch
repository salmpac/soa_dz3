+IConnectionPtr TSslContext::StartClientTls(
+    IConnectionPtr underlying,
+    const IPollerPtr& poller,
+    const std::optional<std::string>& host)
+{
+    auto connection = New<TTlsConnection>(Impl_, poller, std::move(underlying));
+    if (host) {
+        connection->SetHost(*host);
+    }
+    connection->StartClient(Impl_->IsInsecureSkipVerify());
+    return connection;
+}
