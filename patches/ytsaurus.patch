+grpc_status_code ErrorToStatusCode(const TError& error)
+{
+    if (error.IsOK()) {
+        return GRPC_STATUS_OK;
+    }
+
+    if (error.HasAttributes()) {
+        if (auto statusCode = error.Attributes().Find<int>(GrpcStatusCodeAttributeKey)) {
+            if (*statusCode > GRPC_STATUS_OK && *statusCode <= GRPC_STATUS_UNAUTHENTICATED) {
+                return static_cast<grpc_status_code>(*statusCode);
+            }
+        }
+    }
+
+    auto code = error.GetCode();
+    if (code == NYT::EErrorCode::Canceled) {
+        return GRPC_STATUS_CANCELLED;
+    } else if (code == NYT::EErrorCode::Timeout) {
+        return GRPC_STATUS_DEADLINE_EXCEEDED;
+    } else if (code == NRpc::EErrorCode::AuthenticationError) {
+        return GRPC_STATUS_UNAUTHENTICATED;
+    } else if (code == NRpc::EErrorCode::InvalidCredentials) {
+        return GRPC_STATUS_PERMISSION_DENIED;
+    } else if (code == NRpc::EErrorCode::NoSuchService || code == NRpc::EErrorCode::NoSuchMethod) {
+        return GRPC_STATUS_UNIMPLEMENTED;
+    } else if (code == NRpc::EErrorCode::TransportError || code == NRpc::EErrorCode::Unavailable) {
+        return GRPC_STATUS_UNAVAILABLE;
+    } else if (code == NRpc::EErrorCode::RequestQueueSizeLimitExceeded) {
+        return GRPC_STATUS_RESOURCE_EXHAUSTED;
+    }
+    return GRPC_STATUS_UNKNOWN;
+}
