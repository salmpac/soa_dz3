# Скопируйте в .env и поменяйте секреты. Без .env используются дефолты из docker-compose.yml.
POSTGRES_USER=soa
POSTGRES_PASSWORD=soa-db-password
REDIS_PASSWORD=soa-redis-password
FLIGHT_SERVICE_API_KEY=soa-flight-api-key
# Токен администратора для /admin/* (веб-страница использует "admin").
ADMIN_TOKEN=admin

LOG_LEVEL=info
CACHE_TTL_MS=300000

# Неподтверждённая резервация живёт RESERVATION_TTL_MS, затем фоновая задача
# (раз в RESERVATION_SWEEP_PERIOD_MS) переводит её в EXPIRED и возвращает места.
RESERVATION_TTL_MS=600000
RESERVATION_SWEEP_PERIOD_MS=5000

# Booking -> Flight: таймаут попытки, retry, circuit breaker.
FLIGHT_RPC_TIMEOUT_MS=2000
FLIGHT_RETRY_MAX_ATTEMPTS=3
FLIGHT_RETRY_INITIAL_BACKOFF_MS=100
CB_FAILURE_THRESHOLD=5
CB_FAILURE_WINDOW_MS=10000
CB_OPEN_TIMEOUT_MS=15000
